<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day/night window theme: the window background matches the Compose surface so there is no black flash. -->
    <style name="Theme.Penlink" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/penlink_surface</item>
        <item name="android:colorBackground">@color/penlink_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Shown while the process starts; MainActivity switches to Theme.Penlink via installSplashScreen(). -->
    <style name="Theme.Penlink.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background_end</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Penlink</item>
    </style>
</resources>
